# Retrieval protocol
MUSIQUE_SEARCH_URL=http://127.0.0.1:8000/retrieve
MUSIQUE_SEARCH_TIMEOUT=60
MUSIQUE_SEARCH_CONCURRENCY=256
MUSIQUE_TOPK=3
MUSIQUE_MAX_TURNS=3
MUSIQUE_CORPUS_VERSION=musique_v1
MUSIQUE_CLEAN_PROMPT=1

# StateFlow rollout
STATEFLOW_MAX_STEPS=10
STATEFLOW_FEWSHOT=1
STATEFLOW_POOL_DIR=state_pool
STATEFLOW_TRACE_DIR=traces
STATEFLOW_HARVEST_REWARD_THRESHOLD=0.8

# Full/replay curriculum
STATEFLOW_ADAPTIVE_PFULL=1
STATEFLOW_P_FULL=0.85
STATEFLOW_REPLAY_START_STEP=50
STATEFLOW_REPLAY_END_STEP=500
STATEFLOW_REPLAY_START_P_FULL=0.50
STATEFLOW_MIN_REPLAY_GROUPS=0
STATEFLOW_REPLAY_PREFER_TURN_INDEX=

# Adaptive anchor difficulty
STATEFLOW_ADAPTIVE_K=1
STATEFLOW_RHO_LOW=0.25
STATEFLOW_RHO_HIGH=0.75
STATEFLOW_EMA_ALPHA=0.30

# Effective shared reward weights for the direct implementation. The protocol
# Gate supplies the rule-verifiable process constraint; legacy state/path/
# retrieval shaping weights are intentionally omitted.
MUSIQUE_R_OUTCOME=0.45
MUSIQUE_R_EFFICIENCY=0.05
MUSIQUE_R_SOFT_FORMAT=0.05
